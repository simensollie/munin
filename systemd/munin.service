# Munin's recorder daemon, following voxtype.service on this machine exactly:
# that precedent matters, because voxtype is also an audio daemon bound to the
# graphical session and its unit is known to work here.
#
# Why systemd rather than Hyprland's exec-once: a recording must survive a shell
# hot-reload or crash (D20), and only systemd gives restart and lifecycle
# control. XDG_RUNTIME_DIR is set explicitly because every PipeWire tool fails
# silently without it.
#
# Deployed by copy into ~/.config/systemd/user/. Enablement is never committed.

[Unit]
Description=Munin meeting recorder daemon
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/munin-rec
Restart=on-failure
RestartSec=5
Environment=XDG_RUNTIME_DIR=%t
# The default (KillMode=control-group) SIGTERMs pw-record and ffmpeg at the same
# instant as munin-rec, on every `systemctl --user stop` and every logout --
# which is exactly the "logging out mid-meeting" case. capture/linux.py stops the
# recorder first on purpose so ffmpeg sees a clean EOF and writes the Ogg
# trailer; signalling ffmpeg first risks a container with no trailer. KillMode
# mixed sends SIGTERM to munin-rec alone and lets it run that ordering itself.
KillMode=mixed
# Comfortably above the capturer's worst case (~32 s for two tracks), after
# which systemd SIGKILLs whatever is left in the cgroup.
TimeoutStopSec=60

[Install]
WantedBy=graphical-session.target
